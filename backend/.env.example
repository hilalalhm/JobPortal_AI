# ============================================================
# JobPilot AI - Contoh Konfigurasi Lingkungan
# Salin file ini menjadi `.env` lalu isi nilai sebenarnya.
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows)
# JANGAN pernah commit `.env` (sudah di-ignore).
# ============================================================

# ------------------------------------------------------------
# AI PROVIDER (OpenAI-compatible). Provider diuji berurutan;
# yang gagal masuk cooldown 5 menit, lalu beralih ke berikutnya.
# ------------------------------------------------------------

# --- Provider 1 (contoh: OpenRouter) ---
AI_PROVIDER_1_NAME=YourProviderName
AI_PROVIDER_1_KEY=your_api_key_here
AI_PROVIDER_1_URL=https://openrouter.ai/api/v1
AI_PROVIDER_1_MODEL=your-model-id

# --- Provider 2 (contoh: Google Gemini, endpoint OpenAI-compat) ---
AI_PROVIDER_2_NAME=YourProviderName2
AI_PROVIDER_2_KEY=your_api_key_here
AI_PROVIDER_2_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_PROVIDER_2_MODEL=your-model-id

# --- Provider 3 (opsional, pola ekstensi) ---
AI_PROVIDER_3_NAME=YourProviderName3
AI_PROVIDER_3_KEY=your_api_key_here
AI_PROVIDER_3_URL=
AI_PROVIDER_3_MODEL=your-model-id

# ------------------------------------------------------------
# SMTP (kirim email lamaran + lampiran CV)
# ------------------------------------------------------------

# Contoh untuk Gmail:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# Gmail: gunakan App Password (bukan password akun), aktifkan 2FA dulu.
SMTP_PASS=your_app_password_here
# Kosongkan untuk memakai SMTP_USER sebagai pengirim.
SMTP_FROM=
SMTP_FROM_NAME=JobPilot AI
# true = STARTTLS (port 587). Ubah ke false untuk SSL langsung (port 465).
SMTP_TLS=true
